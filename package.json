{
  "name": "legion-training-api",
  "version": "2.0.0",
  "description": "Legion: multi-tenant training and coaching API for gyms, coaches and athletes",
  "private": true,
  "main": "src/app.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "jest --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaulantSela/legion-training-api.git"
  },
  "bugs": {
    "url": "https://github.com/TaulantSela/legion-training-api/issues"
  },
  "homepage": "https://legion-training-api.vercel.app",
  "keywords": [
    "training",
    "workout",
    "gym",
    "coach",
    "multi-tenant"
  ],
  "author": "Taulant Sela",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ]
  }
}
